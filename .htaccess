# ======================================================================
# Dental Show 2027 - Production Apache Server Configuration (.htaccess)
# ======================================================================

# ----------------------------------------------------------------------
# 1. DIRECTORY LISTING & CONTENT NEGOTIATION
# ----------------------------------------------------------------------
# Disable directory listing and turn off MultiViews to prevent URL rewrite conflicts
Options -Indexes -MultiViews

# Default document priority
DirectoryIndex index.html home.html index.php

# ----------------------------------------------------------------------
# 2. REWRITE ENGINE (ROUTING, SSL & CLEAN URLS)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------------------
    # 2.1 PROTECT HIDDEN FILES (EXCEPT .well-known FOR SSL RENEWALS)
    # ------------------------------------------------------------------
    # Block access to .git, .env, etc., while allowing Let's Encrypt / AutoSSL
    RewriteCond %{REQUEST_URI} !^/\.well-known [NC]
    RewriteRule (^|/)\. - [F,L]

    # ------------------------------------------------------------------
    # 2.2 FORCE HTTPS (SSL)
    # ------------------------------------------------------------------
    # Redirect HTTP to HTTPS in production (safely bypassed on localhost)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:X-Forwarded-SSL} !on [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ------------------------------------------------------------------
    # 2.3 CANONICAL HOSTNAME (Optional: www vs non-www)
    # ------------------------------------------------------------------
    # To enforce non-www (https://dentalshow.in), uncomment below:
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # ------------------------------------------------------------------
    # 2.4 STRIP TRAILING SLASH FROM NON-DIRECTORIES
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # ------------------------------------------------------------------
    # 2.5 SPECIAL ROUTE: /events (RESOLVES DIRECTORY VS events.html CLASH)
    # ------------------------------------------------------------------
    RewriteRule ^events/$ /events [R=301,L]
    RewriteRule ^events$ events.html [L]

    # ------------------------------------------------------------------
    # 2.6 CANONICAL ROOT FOR index.html
    # ------------------------------------------------------------------
    # Redirect direct requests for index.html to site root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # ------------------------------------------------------------------
    # 2.7 EXTENSIONLESS CLEAN URLS (.html)
    # ------------------------------------------------------------------
    # Example: /about -> /about.html, /events/dental-show-2027 -> /events/dental-show-2027.html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.html$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 3. BLOCK SENSITIVE FILES & EXTENSIONS
# ----------------------------------------------------------------------
# Block access to backup files, logs, environment configs, and scripts
<FilesMatch "(^#.*#|^\.env|^\.git|\.(bak|conf|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|tpl)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically protect .htaccess and .htpasswd files
<FilesMatch "^\.([Hh][Tt])">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 4. CUSTOM ERROR PAGES
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html

# ----------------------------------------------------------------------
# 5. DEFAULT CHARSET & MIME TYPES
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    # Charsets
    AddCharset UTF-8 .html .css .js .xml .json .rss .atom

    # Modern Web Assets & Fonts
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType application/pdf .pdf
    AddType application/json .json
    AddType image/x-icon .ico
</IfModule>

# ----------------------------------------------------------------------
# 6. GZIP / DEFLATE COMPRESSION (PERFORMANCE)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------
# 7. BROWSER CACHING (LEVERAGE BROWSER CACHE)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Documents (no-cache so updates deploy instantly)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Web Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"

    # Documents & Brochures
    ExpiresByType application/pdf "access plus 1 month"

    # Data interchange
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 8. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent HTML caching during site launch
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Cross-site scripting (XSS) filter
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser features
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # HTTP Strict Transport Security (HSTS) - Set for direct SSL or reverse proxy SSL
    <IfModule mod_setenvif.c>
        SetEnvIf HTTPS on IS_HTTPS
        SetEnvIf X-Forwarded-Proto "^https$" IS_HTTPS
    </IfModule>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=IS_HTTPS
</IfModule>

# ----------------------------------------------------------------------
# 9. CROSS-ORIGIN (CORS) FOR FONTS & STATIC ASSETS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

